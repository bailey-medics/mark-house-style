{
  "name": "checkout-name",
  "displayName": "Checkout name",
  "description": "Shows a short name for the checkout a window has open, such as Quill-2, in the title bar, and opens Claude and tmux terminals with the project's icon on their tabs.",
  "publisher": "local",
  "version": "0.7.1",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configurationDefaults": {
      "window.title": "${checkoutName}",
      "terminal.integrated.tabs.title": "${sequence}",
      "terminal.integrated.tabs.description": ""
    },
    "commands": [
      {
        "command": "checkoutName.openClaude",
        "title": "Open Claude session",
        "category": "Checkout",
        "icon": "$(robot)"
      },
      {
        "command": "checkoutName.openTmux",
        "title": "Open tmux shell",
        "category": "Checkout",
        "icon": "$(file-binary)"
      },
      {
        "command": "checkoutName.openAnotherTmux",
        "title": "Open another tmux shell",
        "category": "Checkout",
        "icon": "$(file-binary)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "checkoutName",
          "title": "Sessions",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "checkoutName": [
        {
          "id": "checkoutName.sessions",
          "name": "Open a session"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "checkoutName.openTmux",
          "group": "navigation@1",
          "alt": "checkoutName.openAnotherTmux"
        },
        {
          "command": "checkoutName.openClaude",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "checkoutName.openClaude",
          "when": "false"
        },
        {
          "command": "checkoutName.openTmux",
          "when": "false"
        },
        {
          "command": "checkoutName.openAnotherTmux",
          "when": "false"
        }
      ]
    }
  }
}
