# Mark's personal recipes, for every repository. This file is linked from
# ~/.config/just/justfile. A repository loads it with one line, so its
# recipes run there as plain `just <recipe>`:
#
#     import? '~/.config/just/justfile'
#
# Anywhere else, run them with `just -g <recipe>`. Every recipe is [no-cd]:
# it runs in the repository it is called from, not beside this file.
#
# Because a repository imports it, this file sets nothing: just refuses a
# setting made twice, and repositories set `shell` themselves. So a recipe
# that needs bash starts with its own `#!/usr/bin/env bash` line, and the
# rest are plain sh. No recipe here may share a name with a recipe of a
# repository that imports it, or just will not load there.
#
# The helper scripts live in mark-house-style/scripts/, by full path.

house := home_directory() / "github" / "mark-house-style"

# Topics kept in files of their own, so other repositories can load them
# too, with `import?`, and run them without `-g`: just rfb, just rdp,
# just cc.
import '~/github/mark-house-style/just/banners.just'
import '~/github/mark-house-style/just/remote-desktop.just'
import '~/github/mark-house-style/just/session.just'
import '~/github/mark-house-style/just/stack.just'


alias tl := turva-link
# Point this Turva checkout or worktree at mark-house-style (safe to run again)
[no-cd]
turva-link:
    @"{{house}}"/scripts/turva-link.sh


# Voice bridge
#
# The channel that lets a voice chat on the phone talk to a Claude session
# on the box. Its code is in mark-house-style/voice/; see the README there.
voice := house / "voice"


alias voicet := voice-test
# Run the voice channel's tests
[no-cd]
voice-test:
    cd "{{voice}}" && npm test


alias vtc := voice-typecheck
# Type check the voice channel
[no-cd]
voice-typecheck:
    cd "{{voice}}" && npm run typecheck
